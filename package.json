{
  "name": "tele-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Telegram bridge for Codex CLI sessions.",
  "license": "MIT",
  "keywords": [
    "codex",
    "telegram",
    "bot",
    "cli",
    "automation",
    "json-rpc"
  ],
  "bin": {
    "tele-codex": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "contract:check": "node scripts/appserver-contract.mjs",
    "contract:fixture": "node scripts/appserver-contract.mjs --fixture-only",
    "contract:refresh": "node scripts/appserver-contract.mjs --refresh",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:appserver": "npm run contract:check && node scripts/appserver-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grammyjs/types": "^3.20.0",
    "better-sqlite3": "^11.8.1",
    "grammy": "^1.34.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
